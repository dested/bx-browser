{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Flow files import "bx/flow"; the alias survives the npm package being
    // named bx-browser (bx run rewrites it at load time — see flows/runner.ts).
    "paths": {
      "bx/flow": ["./src/flows/api.ts"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "flows/**/*.ts", "tests/**/*.ts"]
}
